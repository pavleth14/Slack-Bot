PORT=5002

SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret

# Channel where truck switch posts appear (invite the bot to this channel)
SLACK_CHANNEL_ID=C0000000000

# Comma-separated department inboxes
DEPARTMENT_EMAILS=dispatch@example.com,safety@example.com

# Optional: comma-separated Slack user IDs; leave empty to allow everyone
SLACK_ALLOWED_USER_IDS=

# Optional: Slack user group ID for @safetyteam (Slack → User groups → copy ID)
SLACK_SAFETY_TEAM_USERGROUP_ID=

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@twobrothersfreight.com
