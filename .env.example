PORT=5002

SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret

SLACK_CHANNEL_ID=C0000000000

# /loads posts here only (required; invite bot to this channel)
SLACK_LOADS_CHANNEL_ID=C0000000000

DEPARTMENT_EMAILS=dispatch@example.com,safety@example.com

SLACK_ALLOWED_USER_IDS=

SLACK_SAFETY_TEAM_USERGROUP_ID=
SLACK_MAINTENANCE_TEAM_USERGROUP_ID=
SLACK_TRACK_AND_TRACE_TEAM_USERGROUP_ID=

# Optional overrides if usergroups are not used (comma-separated Slack user IDs)
SLACK_SAFETY_ALLOWED_USER_IDS=
SLACK_MAINTENANCE_ALLOWED_USER_IDS=
SLACK_TRACK_AND_TRACE_ALLOWED_USER_IDS=

# Optional file upload in /truckswitch modal (needs files:read + files:write on the Slack app)
SLACK_ENABLE_MODAL_FILES=true

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@twobrothersfreight.com
